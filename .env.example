# Local SQLite is used when DATABASE_URL is blank. PostgreSQL is required for hosting.
DATABASE_URL=
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=falguniadmin@gmail.com
# Set ADMIN_EMAIL plus ADMIN_PASSWORD or ADMIN_PASSWORD_HASH privately.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
SITE_URL=http://localhost:5000
# Original variable remains supported as a fallback for SITE_URL.
NEXT_PUBLIC_SITE_URL=
APP_ENV=development
# Original optional integration settings retained; adapters were not implemented in the original.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-media
YOUTUBE_API_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
